---
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/Badge.astro';
import { site, nav } from '../lib/site';
import { formatDate } from '../lib/wow';
import { CONFIDENCE } from '../lib/confidence';
import type { Confidence } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  rail?: 'md' | 'lg'; // breakpoint from which the rail slot becomes a left column (900 / 1200)
  wide?: boolean; // body may use the full page width (home)
  dock?: boolean; // checklist page with the phone dock (Route, Library books)
  guide?: string; // guide id: sets data-guide on <html> for the guide's --class theme
}

const { title, description = site.tagline, rail, wide = false, dock = false, guide } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title === site.name ? `${site.name}: ${site.tagline}` : `${title} | ${site.name}`;
const hasHead = Astro.slots.has('head');
const hasRail = Astro.slots.has('rail');
const isGuidePage = (href: string) => path.startsWith(href) && href.startsWith('/guides/');
const LEVELS: Confidence[] = ['official', 'beta-tested', 'community', 'theory'];
---

<!doctype html>
<html lang="en" class:list={{ 'has-dock': dock }} data-guide={guide}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400..700;1,400..700&family=Texturina:opsz,wght@12..72,600..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Before paint: saved theme (no flash of the wrong theme) and saved level (no flash of the "unset" level border).
      try {
        const read = (k) => {
          const raw = localStorage.getItem('waypoint:v1:' + k);
          if (raw === null) return null;
          try {
            return JSON.parse(raw);
          } catch (e) {
            return raw;
          }
        };
        const t = read('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        const lv = read('level');
        if (typeof lv === 'number' && lv >= 1 && lv <= 60) document.documentElement.dataset.level = String(lv);
      } catch (e) {}
    </script>
    <script is:inline>
      const whTooltips = { colorLinks: true, iconizeLinks: true, renameLinks: false };
    </script>
    <script is:inline src="https://wow.zamimg.com/js/tooltips.js" defer></script>
  </head>
  <body>
    <Icons />
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/"><Icon name="mark" size={24} /><span>{site.name}</span></a>
        <div id="site-menu" class="site-menu">
          <nav aria-label="Main">
            <ul class="nav-list">
              {
                nav.map((n) => (
                  <li>
                    <a href={n.href} aria-current={path === n.href && !n.children ? 'page' : isGuidePage(n.href) ? 'true' : undefined}>
                      {n.label}
                    </a>
                    {n.children && (
                      <ul class="nav-sub">
                        {n.children.map((c) => (
                          <li>
                            <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                              {c.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="appearance">
            <span class="appearance-label">Appearance</span>
            <button class="btn theme-btn" id="theme-btn" type="button" aria-label="Theme: Auto. Change theme">
              <Icon name="auto" data-theme-icon="system" class="on" /><Icon name="sun" data-theme-icon="light" /><Icon
                name="moon"
                data-theme-icon="dark"
              /><span data-theme-label>Auto</span>
            </button>
          </div>
          <a class="menu-report" href={site.reportUrl} target="_blank" rel="noopener"><Icon name="flag" size={16} />Report a problem</a>
        </div>
        <div class="lvl" role="group" aria-label="My level">
          <button type="button" class="lvl-btn" data-action="level-down" aria-label="Level down"><Icon name="minus" /></button>
          <label class="lvl-field"
            ><span class="lvl-prefix" aria-hidden="true">Lv</span><input
              id="my-level"
              type="number"
              min="1"
              max="60"
              inputmode="numeric"
              placeholder="?"
              aria-label="My level"
            /></label
          >
          <button type="button" class="lvl-btn" data-action="level-up" aria-label="Level up"><Icon name="plus" /></button>
        </div>
        <button class="menu-btn btn" type="button" data-action="menu" aria-expanded="false" aria-controls="site-menu">
          <Icon name="menu" /><Icon name="close" /><span class="menu-label" data-menu-label>Menu</span>
        </button>
      </div>
    </header>

    <main id="main" class:list={[rail && `rail-${rail}`, { wide }]}>
      {
        hasHead && (
          <div class="page-head-area">
            <slot name="head" />
          </div>
        )
      }
      {
        hasRail && (
          <aside class="page-rail">
            <slot name="rail" />
          </aside>
        )
      }
      <div class="page-body">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <section aria-labelledby="trust-legend">
            <h2 id="trust-legend">How much to trust a fact</h2>
            <ul class="legend">
              {
                LEVELS.map((c) => (
                  <li>
                    <Badge c={c} />
                    <span>{CONFIDENCE[c].meaning}.</span>
                  </li>
                ))
              }
            </ul>
          </section>
          <section aria-labelledby="about-site">
            <h2 id="about-site">About {site.name}</h2>
            <p>
              {site.name} is a fan-made guide built from beta data (17 Sep – 22 Oct 2026). Data updated
              <time datetime={site.dataUpdated}>{formatDate(site.dataUpdated)}</time>.
            </p>
            <p class="foot-links">
              <a href={site.reportUrl} target="_blank" rel="noopener"><Icon name="flag" size={16} />Report a problem</a>
              <a href="/design-system/">Design system</a>
            </p>
          </section>
        </div>
        <p class="legal">
          Not affiliated with or endorsed by Blizzard Entertainment. World of Warcraft and Warcraft are trademarks of Blizzard
          Entertainment, Inc. Item tooltips by <a href="https://www.wowhead.com/forever">Wowhead</a>.
        </p>
      </div>
    </footer>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script>
      import { initLevel } from '../scripts/level';
      import { initTheme } from '../scripts/theme';
      import { initCopy } from '../scripts/copy';
      import { initMenu } from '../scripts/menu';
      import { initRail } from '../scripts/rail';
      initLevel();
      initTheme();
      initCopy();
      initMenu();
      initRail();
    </script>
  </body>
</html>
