---
// Sources without a confidence seal (e.g. a table's sources). A 44px disclosure with a list of links.
import Icon from './Icon.astro';
import { sourceLabel } from '../lib/sources';

interface Props {
  urls: string[];
}

const { urls } = Astro.props;
---

{
  urls.length > 0 && (
    <details class="sources">
      <summary>
        Sources ({urls.length})
        <Icon name="chevron-down" size={16} class="chev" />
      </summary>
      <ul class="src-list">
        {urls.map((u) => (
          <li>
            <a href={u} target="_blank" rel="noopener">
              <Icon name="external" size={16} />
              {sourceLabel(u)}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}
