---
// Static confidence seal: pips + word. No hue except Theory. Use Trust.astro when sources should be reachable.
import type { Confidence } from '../lib/data';
import { CONFIDENCE } from '../lib/confidence';

interface Props {
  c: Confidence;
}

const { c } = Astro.props;
const info = CONFIDENCE[c];
---

<span class={`seal ${c}`} title={info.meaning}
  ><span class="pips" aria-hidden="true">{[0, 1, 2].map((i) => <i class={i < info.pips ? 'on' : undefined} />)}</span>{
    info.word
  }</span
>
