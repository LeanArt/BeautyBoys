---
// A named thing (quest, NPC, item, vendor, book) with an optional Wowhead link and coordinate button.
// variant="row" (default): fixed-slot row inside <ul class="ref-list"><li>…</li></ul>.
// variant="inline": just the name link, for refs inside sentences and short lists (no coordinate button).
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import WayButton from './WayButton.astro';
import { wowheadUrl, wayCommand } from '../lib/wow';
import { md } from '../lib/md';
import type { Ref } from '../lib/data';

export type RefKind = 'quest' | 'npc' | 'item' | 'vendor' | 'book';

interface Props {
  r: Ref & { giver?: string; role?: string };
  zone?: string; // fallback zone for /way when the ref has coords but no zone
  kind?: RefKind;
  variant?: 'row' | 'inline';
  price?: string;
  detail?: string; // overrides line 2
}

const GLYPH: Record<RefKind, IconName> = { quest: 'quest', npc: 'person', item: 'pouch', vendor: 'person', book: 'book' };

const { r, zone, variant = 'row', price, detail } = Astro.props;
const kind: RefKind = Astro.props.kind ?? (r.role ? 'npc' : r.giver ? 'quest' : 'item');
const wayZone = r.zone ?? zone;
const way = r.coords && wayZone ? wayCommand(wayZone, r.coords, r.name) : null;
const line2 = detail ?? r.role ?? (r.giver ? `From ${r.giver}` : undefined);
---

{
  variant === 'inline' ? (
    <span class="ref-inline">{r.wh ? <a href={wowheadUrl(r.wh)} target="_blank" rel="noopener">{r.name}</a> : r.name}</span>
  ) : (
    <div class="ref">
      <Icon class={`ref-glyph ${kind}`} name={GLYPH[kind]} />
      {r.wh ? <a class="ref-name" href={wowheadUrl(r.wh)} target="_blank" rel="noopener">{r.name}</a> : <span class="ref-name">{r.name}</span>}
      {price && <span class="ref-price num">{price}</span>}
      {line2 && <span class="ref-detail">{line2}</span>}
      {r.note && <span class="ref-note" set:html={md(r.note)} />}
      {way && r.coords && <WayButton way={way} coords={r.coords} />}
    </div>
  )
}
