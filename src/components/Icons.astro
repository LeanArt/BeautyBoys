  <!-- bag verdicts -->
  <symbol id="i-keep" viewBox="0 0 24 24"><path d="M6 6.5h12a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 18 20.5H6A1.5 1.5 0 0 1 4.5 19V8A1.5 1.5 0 0 1 6 6.5z"></path><path d="M9 6.5 7.5 3.5h9L15 6.5"></path><path d="M9.5 14l2 2 3.5-3.5"></path></symbol>
  <symbol id="i-bank" viewBox="0 0 24 24"><path d="M3.5 10a8.5 5.5 0 0 1 17 0v10h-17z"></path><path d="M3.5 13.5h17"></path><path d="M10.5 12h3v3h-3z"></path></symbol>
  <symbol id="i-sell" viewBox="0 0 24 24"><path d="M5 7.5a7 2.5 0 1 0 14 0a7 2.5 0 1 0-14 0"></path><path d="M5 7.5v4c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-4"></path><path d="M5 11.5v4c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-4"></path></symbol>
  <symbol id="i-auction" viewBox="0 0 24 24"><path d="M13.6 3.2l6.4 6.4-2.6 2.6L11 5.8z"></path><path d="M14.3 9 5 18.3"></path><path d="M3 21h9"></path></symbol>
  <symbol id="i-buy" viewBox="0 0 24 24"><path d="M3.5 9.5h17l-1.8 9.5a1.5 1.5 0 0 1-1.5 1.2H6.8a1.5 1.5 0 0 1-1.5-1.2z"></path><path d="M8 9.5l3-5.5M16 9.5l-3-5.5"></path><path d="M9 13v4M15 13v4"></path></symbol>
