---
// The one hidden icon sprite, rendered once at the top of <body> by Base.astro.
// Every glyph is drawn for Waypoint on a 24x24 grid: stroke = currentColor, round caps and joins,
// no fills except where noted (fill="currentColor" stroke="none"). No icon library, no game art.
// Use <Icon name="..." /> to place one. Add a glyph: a new <symbol id="i-NAME"> here + docs/DESIGN.md.
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <!-- brand -->
  <symbol id="i-mark" viewBox="0 0 24 24"><path d="M12 1.5v21" stroke-width="2"></path><path d="M12 6.5l5 5.5-5 5.5-5-5.5z" fill="currentColor" stroke="none"></path></symbol>

  <!-- step kinds -->
  <symbol id="i-signpost" viewBox="0 0 24 24"><path d="M12 21.5V2.5"></path><path d="M5 5h11l3 2.5-3 2.5H5z"></path><path d="M19 12.5H8l-3 2.5 3 2.5h11z"></path></symbol>
  <symbol id="i-quest" viewBox="0 0 24 24"><path d="M10.4 3.5h3.2l-.7 11.2h-1.8z" fill="currentColor" stroke="none"></path><circle cx="12" cy="19" r="1.8" fill="currentColor" stroke="none"></circle></symbol>
  <symbol id="i-turnin" viewBox="0 0 24 24"><path d="M8.8 8.6a3.3 3.3 0 1 1 4.9 2.9c-1 .6-1.7 1.3-1.7 2.5v.8" stroke-width="2.5"></path><circle cx="12" cy="19" r="1.8" fill="currentColor" stroke="none"></circle></symbol>
  <symbol id="i-flame" viewBox="0 0 24 24"><path d="M12 21.5c-3.6 0-6.5-2.6-6.5-6.3 0-3.6 3-5.6 3.7-8.7 1.5 1.2 2 2.7 2 4.2 1.5-.9 2.6-3.3 2.3-6.2 3.3 2 5.5 6 5.5 10.2 0 3.9-3 6.8-7 6.8z"></path></symbol>
  <symbol id="i-book" viewBox="0 0 24 24"><path d="M3.5 5.5c2.8-1.2 5.8-1.2 8.5.6 2.7-1.8 5.7-1.8 8.5-.6v13.4c-2.8-1.1-5.8-1.1-8.5.6-2.7-1.7-5.7-1.7-8.5-.6z"></path><path d="M12 6.1v13.4"></path></symbol>
  <symbol id="i-gate" viewBox="0 0 24 24"><path d="M5 21V10.5a7 7 0 0 1 14 0V21"></path><path d="M3 21h18"></path><path d="M9 21v-7.5M12 21v-9M15 21v-7.5"></path></symbol>
  <symbol id="i-anvil" viewBox="0 0 24 24"><path d="M3.5 7.5h12.5a4.5 4.5 0 0 0 4.5 4.5l-4.5 1-1.5 2.5h-6l-1.5-2.5A3.5 3.5 0 0 1 3.5 9.5z"></path><path d="M9 15.5 8 20.5h8l-1-5"></path></symbol>
  <symbol id="i-rune" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 5.5l1.7 4.8 4.8 1.7-4.8 1.7L12 18.5l-1.7-4.8L5.5 12l4.8-1.7z"></path></symbol>
  <symbol id="i-coin" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><circle cx="12" cy="12" r="5"></circle></symbol>
  <symbol id="i-lantern" viewBox="0 0 24 24"><path d="M12 2v2.5M9 4.5h6"></path><path d="M8 7.5h8l-.8 11H8.8z"></path><path d="M7 21h10"></path><path d="M12 11.5c1 1 1.3 2 0 3.5-1.3-1.5-1-2.5 0-3.5z"></path></symbol>
  <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.5 6 .7-4.4 4.1 1.2 5.9L12 16.8l-5.4 2.9 1.2-5.9L3.4 9.7l6-.7z"></path></symbol>

