---
import type { Guide } from '../lib/guides';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const base = `/guides/${guide.id}/`;
const links = [
  { href: base, label: 'Overview' },
  { href: `${base}route/`, label: 'Route' },
  { href: `${base}talents/`, label: 'Talents, spells & demons' },
  { href: `${base}professions/`, label: 'Professions & alts' },
];
const path = Astro.url.pathname;
---

<nav class="guide-nav" aria-label={`${guide.race} ${guide.className} guide`}>
  {
    links.map((l) => (
      <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
        {l.label}
      </a>
    ))
  }
</nav>

<style>
  .guide-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border);
    margin: 0.5rem 0 1.5rem;
  }
  .guide-nav a {
    padding: 0.45rem 0.75rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .guide-nav a:hover {
    color: var(--text);
  }
  .guide-nav a[aria-current='page'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
