---
// Guide sub-nav: Overview, Route, Fastest route, Talents, Professions. One scrolling row on phones (never wraps).
import { guidePages, type Guide } from '../lib/guides';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const path = Astro.url.pathname;
const pages = guidePages(guide);
// The tab for this page, or for the section this page sits in (the fastest route's leg pages);
// the longest matching prefix wins so the Overview tab only matches itself.
const section = pages.filter((l) => path.startsWith(l.href)).sort((a, b) => b.href.length - a.href.length)[0];
---

<nav class="guide-nav" aria-label={`${guide.race} ${guide.className} guide`}>
  {
    pages.map((l) => (
      <a href={l.href} aria-current={path === l.href ? 'page' : l === section ? 'true' : undefined}>
        {l.label}
      </a>
    ))
  }
</nav>

<script>
  // Bring the active link into the scrolling row without moving the page vertically, and fade the edge
  // (data-more="start|end|both") on any side that has links scrolled out of view.
  document.querySelectorAll<HTMLElement>('.guide-nav').forEach((nav) => {
    const a = nav.querySelector<HTMLElement>('[aria-current]');
    if (a && a.offsetLeft + a.offsetWidth > nav.clientWidth) nav.scrollLeft = a.offsetLeft - 16;
    const mark = () => {
      const start = nav.scrollLeft > 1;
      const end = nav.scrollLeft + nav.clientWidth < nav.scrollWidth - 1;
      if (start || end) nav.dataset.more = start && end ? 'both' : start ? 'start' : 'end';
      else delete nav.dataset.more;
    };
    mark();
    nav.addEventListener('scroll', mark, { passive: true });
    addEventListener('resize', mark);
    document.fonts?.ready.then(mark); // web fonts change the link widths
  });
</script>
