---
// One route step: a waymark row on the ley line (docs/DESIGN.md, section 3 "Route step").
// Contract: li.step[id][data-lmin][data-lmax] + input[data-step]; progress.ts adds .done, data-next, .open.
// `demo` (style guide only): renders a fixed state; no data-lmin/data-lmax/data-step, so no script touches it.
import Icon from './Icon.astro';
import Waymark from './Waymark.astro';
import Trust from './Trust.astro';
import RefItem from './RefItem.astro';
import WayButton from './WayButton.astro';
import { md } from '../lib/md';
import { levelLabel, wayCommand, coordLabel } from '../lib/wow';
import type { Step } from '../lib/data';
import { KIND } from '../lib/kinds';
import type { Ladder } from '../scripts/level';

interface Props {
  step: Step;
  demo?: {
    done?: boolean;
    next?: boolean;
    open?: boolean;
    flash?: boolean;
    now?: 'past' | 'current' | 'future';
    ladder?: Ladder;
  };
}

const { step, demo } = Astro.props;
const LADDER_WORD: Record<Ladder, string> = { 'too-hard': 'too hard', hard: 'hard', 'on-level': 'on level', easy: 'easy', trivial: 'trivial' };

const kind = KIND[step.kind];
const place = [step.hub, step.zone].filter(Boolean).join(', ');

// Key waypoint: the first quest, person or item with coordinates.
const keyRef = [...(step.quests ?? []), ...(step.npcs ?? []), ...(step.items ?? [])].find((r) => r.coords);
const keyZone = keyRef ? keyRef.zone ?? step.zone : undefined;
const keyWay = keyRef?.coords && keyZone ? wayCommand(keyZone, keyRef.coords, keyRef.name) : undefined;
const groups = [
  { label: 'Quests', refs: step.quests ?? [], kind: 'quest' as const },
  { label: 'People', refs: step.npcs ?? [], kind: 'npc' as const },
  { label: 'Items', refs: step.items ?? [], kind: 'item' as const },
].filter((g) => g.refs.length > 0);
---

<li
  class:list={['step', `kind-${step.kind}`, { theory: step.confidence === 'theory', done: demo?.done, open: demo?.open, flash: demo?.flash }]}
  id={step.id}
  data-lmin={demo ? undefined : step.level[0]}
  data-lmax={demo ? undefined : step.level[1]}
  data-now={demo?.now}
  data-next={demo?.next ? '' : undefined}
  aria-current={demo?.next ? 'step' : undefined}
  data-title={step.title}
  data-way={keyWay}
  data-way-label={keyRef?.coords ? coordLabel(keyRef.coords) : undefined}
>
  <Waymark id={step.id} glyph={kind.glyph} label={`Mark "${step.title}" done`} demo={demo && { checked: demo.done }} />
  <div class="step-main">
    <p class="next-flag"><span class="tag next">Next step</span></p>
    <h3 class="step-title">{step.title} <span class="tag done">Done</span></h3>
    <div class="facts">
      {
        demo ? (
          <span class="tag lv num" data-ladder={demo.ladder}>
            {levelLabel(step.level)} <span class="ladder">{demo.ladder && LADDER_WORD[demo.ladder]}</span>
          </span>
        ) : (
          <span class="tag lv num" data-lmin={step.level[0]} data-lmax={step.level[1]} data-ladder-tag>
            {levelLabel(step.level)} <span class="ladder" />
          </span>
        )
      }
      <span class="kind">{kind.word}</span>
      {
        place && (
          <span class="place">
            <Icon name="pin" size={16} />
            {place}
          </span>
        )
      }
      {step.optional && <span class="tag optional">Optional</span>}
      {keyWay && keyRef?.coords && <WayButton way={keyWay} coords={keyRef.coords} class="key" />}
      <Trust c={step.confidence} urls={step.sources} report={`route step "${step.title}" (${step.id})`} />
    </div>
    <div class="detail">
      <p class="body" set:html={md(step.body)} />
      {
        groups.map((g) => (
          <div class="refs">
            <h4 class="refs-label">{g.label}</h4>
            <ul class="ref-list">
              {g.refs.map((r) => (
                <li>
                  <RefItem r={r} zone={step.zone} kind={g.kind} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <label class="btn mark-done" for={`chk-${step.id}`} aria-hidden="true"><Icon name="check" size={16} />Mark done</label>
    </div>
    <button class="btn quiet step-toggle" type="button" data-action="details" aria-expanded={demo?.open ? 'true' : 'false'}
      ><span data-details-label>{demo?.open ? 'Hide details' : 'Show details'}</span><Icon name="chevron-down" size={16} class="chev" /></button
    >
  </div>
</li>
