---
import Badge from './Badge.astro';
import Sources from './Sources.astro';
import RefItem from './RefItem.astro';
import { md } from '../lib/md';
import { levelLabel } from '../lib/wow';
import { reportHref } from '../lib/site';
import type { Step } from '../lib/data';

interface Props {
  step: Step;
}

const { step } = Astro.props;

const KIND: Record<Step['kind'], string> = {
  travel: 'Travel',
  quests: 'Quests',
  class: 'Class',
  train: 'Train',
  dungeon: 'Dungeon',
  profession: 'Profession',
  system: 'Forever system',
  shopping: 'Shopping',
  tip: 'Tip',
  milestone: 'Milestone',
};
const where = [step.zone, step.hub].filter(Boolean).join(' · ');
---

<article class={`step kind-${step.kind}`} id={step.id} data-lmin={step.level[0]} data-lmax={step.level[1]}>
  <label class="check">
    <input type="checkbox" data-step={step.id} />
    <span class="visually-hidden">Mark "{step.title}" done</span>
  </label>
  <div class="content">
    <header>
      <h3>{step.title}</h3>
      <div class="meta">
        <span class="pill level">{levelLabel(step.level)}</span>
        <span class={`pill kind`}>{KIND[step.kind]}</span>
        {step.optional && <span class="pill">optional</span>}
        <Badge c={step.confidence} />
      </div>
    </header>
    <p class="where">{where}</p>
    <p class="body" set:html={md(step.body)} />

    {
      step.quests && step.quests.length > 0 && (
        <div class="refs">
          <h4>Key quests</h4>
          <ul>
            {step.quests.map((q) => (
              <li>
                <RefItem r={q} zone={step.zone} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      step.npcs && step.npcs.length > 0 && (
        <div class="refs">
          <h4>Who</h4>
          <ul>
            {step.npcs.map((n) => (
              <li>
                <RefItem r={n} zone={step.zone} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      step.items && step.items.length > 0 && (
        <div class="refs">
          <h4>Items</h4>
          <ul>
            {step.items.map((i) => (
              <li>
                <RefItem r={i} zone={step.zone} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="foot">
      <Sources urls={step.sources} />
      <a class="report small" href={reportHref(`route step "${step.title}" (${step.id})`)} target="_blank" rel="noopener"
        >Report a problem</a
      >
    </div>
  </div>
</article>

<style>
  .step {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--border);
    border-radius: var(--radius);
    padding: 0.85rem 1rem 0.75rem 0.6rem;
    margin: 0 0 0.7rem;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .step.kind-class,
  .step.kind-train {
    border-left-color: var(--accent);
  }
  .step.kind-dungeon {
    border-left-color: var(--danger);
  }
  .step.kind-system {
    border-left-color: var(--info);
  }
  .step.kind-profession,
  .step.kind-shopping {
    border-left-color: var(--gold);
  }
  .step.kind-milestone {
    border-left-color: var(--fel);
  }
  .step[data-now='current'] {
    box-shadow: 0 0 0 2px var(--accent-soft);
  }
  .step.done {
    opacity: 0.55;
  }
  .step.done h3 {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  :global(.hide-done) .step.done {
    display: none;
  }
  .step:global(.flash) {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .check {
    display: flex;
    justify-content: center;
    padding-top: 0.15rem;
    cursor: pointer;
  }
  .check input {
    width: 1.45rem;
    height: 1.45rem;
    accent-color: var(--fel);
    cursor: pointer;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 0.8rem;
  }
  h3 {
    margin: 0;
    font-size: 1.12rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .where {
    margin: 0.15rem 0 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .body {
    margin-bottom: 0.4rem;
  }
  .refs h4 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin: 0.6rem 0 0.2rem;
  }
  .refs ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .refs li {
    margin: 0.2rem 0;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }
  .report {
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .step {
      grid-template-columns: 2rem 1fr;
      padding-right: 0.75rem;
    }
  }
</style>
