---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import LedgerItem from '../components/LedgerItem.astro';
import Callout from '../components/Callout.astro';
import Icon from '../components/Icon.astro';
import { bags } from '../lib/data';
import { ACTIONS, LABEL, CATEGORIES } from '../lib/bags';

const data = bags();

const items = data?.items ?? [];
const counts = Object.fromEntries(ACTIONS.map((a) => [a.id, items.filter((i) => i.action === a.id).length]));
const usedCategories = Object.keys(CATEGORIES).filter((c) => items.some((i) => i.category === c));
---

<Base
  title="Bag advisor"
  description="What to keep, sell, bank or buy in WoW: Forever, by level, with vendors and coordinates."
  rail="md"
>
  <Fragment slot="head">
    <PageHead title="Bag advisor" levelPrompt>
      Bags fill up fast. Here's what to keep, sell, bank or buy at your level, and where to buy it.
    </PageHead>
    <section class="rules" aria-labelledby="rules-title">
      <h2 id="rules-title">Rules of thumb</h2>
      <ul>
        <li>
          <span class="verdict act-sell"><Icon name="sell" size={16} />Sell</span>
          <span><strong>Grey item?</strong> Sell it to any vendor. Always.</span>
        </li>
        <li>
          <span class="verdict act-keep"><Icon name="keep" size={16} />Keep</span>
          <span
            ><strong>Letter, note or odd object from a quest?</strong> Keep it until the quest is done; deleting it abandons the
            quest.</span
          >
        </li>
        <li>
          <span class="verdict act-keep"><Icon name="keep" size={16} />Keep</span>
          <span><strong>Cloth?</strong> Keep it. Tailoring eats it, and Waylaid Crates want it.</span>
        </li>
        <li>
          <span class="verdict act-sell"><Icon name="sell" size={16} />Sell</span>
          <span><strong>Mail or plate armor?</strong> You can't wear it. Sell it, or auction it if it's green or better.</span>
        </li>
      </ul>
    </section>
  </Fragment>

  {
    data && (
      <form slot="rail" class="filters" id="bag-filters" onsubmit="return false" aria-label="Filter the bag advisor">
        <div class="field">
          <label class="label" for="bag-q">
            Search your bags
          </label>
          <span class="search-field">
            <Icon name="search" />
            <input type="search" id="bag-q" name="q" placeholder="Cloth, wand, crate…" autocomplete="off" />
            <button type="button" class="btn icon quiet clear" data-clear aria-label="Clear search" hidden>
              <Icon name="close" />
            </button>
          </span>
        </div>
        <div class="field">
          <label class="label" for="bag-cat">
            Category
          </label>
          <span class="select-field">
            <select id="bag-cat" name="cat">
              <option value="">All categories</option>
              {usedCategories.map((c) => (
                <option value={c}>{CATEGORIES[c]}</option>
              ))}
            </select>
            <Icon name="chevron-down" />
          </span>
        </div>
        <label class="switch">
          <input type="checkbox" name="mine" role="switch" checked />
          <span>
            Only my level<span class="needs-level"> (set your level first)</span>
          </span>
          <span class="track" aria-hidden="true" />
        </label>
        <div class="field">
          <p class="label" id="chips-label">What to do with it</p>
          <div class="chips" role="group" aria-labelledby="chips-label">
            {ACTIONS.filter((a) => counts[a.id] > 0).map((a) => (
              <button type="button" class={`chip act-${a.id}`} data-act={a.id} aria-pressed="false">
                <Icon name={a.id} class="chip-icon" />
                <Icon name="check" class="chip-check" />
                {a.label} <span class="chip-count num">{counts[a.id]}</span>
              </button>
            ))}
          </div>
        </div>
        <p id="bag-status" class="bag-status" aria-live="polite"></p>
      </form>
    )
  }

  {
    !data ? (
      <Callout variant="warn">
        <p>The bag advisor is being filled in. Check back soon.</p>
      </Callout>
    ) : (
      <Fragment>
        <div class="ledger" id="bag-items">
          {items.map((i) => (
            <LedgerItem item={i} verdict={LABEL[i.action]} category={CATEGORIES[i.category]} />
          ))}
        </div>
        <Callout variant="info" id="bag-empty" hidden>
          <p id="bag-empty-msg">No items match. Clear the search or turn off Only my level.</p>
          <button type="button" class="btn" data-clear-filters>
            Clear filters
          </button>
        </Callout>
      </Fragment>
    )
  }
</Base>

<script>
  import { getLevel, LEVEL_EVENT } from '../scripts/level';
  import { load, save } from '../scripts/storage';

  const form = document.getElementById('bag-filters') as HTMLFormElement | null;
  if (form) {
    const cards = [...document.querySelectorAll<HTMLElement>('#bag-items .item')];
    const chips = [...form.querySelectorAll<HTMLButtonElement>('[data-act]')];
    const q = form.elements.namedItem('q') as HTMLInputElement;
    const cat = form.elements.namedItem('cat') as HTMLSelectElement;
    const mine = form.elements.namedItem('mine') as HTMLInputElement;
    const clearQ = form.querySelector<HTMLButtonElement>('[data-clear]');
    const status = document.getElementById('bag-status')!;
    const empty = document.getElementById('bag-empty')!;
    const emptyMsg = document.getElementById('bag-empty-msg');
    const chipLabel = (c: HTMLButtonElement) => c.dataset.act!.charAt(0).toUpperCase() + c.dataset.act!.slice(1);

    const saved = load<{ acts: string[]; cat: string; mine: boolean }>('bags-filter', { acts: [], cat: '', mine: true });
    chips.forEach((c) => c.setAttribute('aria-pressed', String(saved.acts.includes(c.dataset.act!))));
    cat.value = saved.cat;
    mine.checked = saved.mine;

    function apply() {
      const on = chips.filter((c) => c.getAttribute('aria-pressed') === 'true');
      const acts = on.map((c) => c.dataset.act!);
      const text = q.value.trim().toLowerCase();
      const level = getLevel();
      const useLevel = mine.checked && level !== null;
      let shown = 0;
      for (const card of cards) {
        const ok =
          (acts.length === 0 || acts.includes(card.dataset.act!)) &&
          (!cat.value || card.dataset.cat === cat.value) &&
          (!text || card.dataset.text!.includes(text)) &&
          (!useLevel || (level! >= Number(card.dataset.lmin) && level! <= Number(card.dataset.lmax)));
        card.hidden = !ok;
        if (ok) shown++;
      }
      if (clearQ) clearQ.hidden = q.value === '';
      empty.hidden = shown > 0;

      // "Showing 3 of 78 items: Sell, level 14."
      const parts: string[] = [];
      if (on.length) parts.push(on.map(chipLabel).join(', '));
      if (cat.value) parts.push(cat.selectedOptions[0]?.textContent ?? cat.value);
      if (text) parts.push(`“${q.value.trim()}”`);
      if (useLevel) parts.push(`level ${level}`);
      const strong = document.createElement('strong');
      strong.textContent = String(shown);
      const tail =
        mine.checked && level === null
          ? ` of ${cards.length}. Set your level at the top to filter by level.`
          : ` of ${cards.length} items${parts.length ? `: ${parts.join(', ')}` : ''}.`;
      status.replaceChildren('Showing ', strong, tail);

      if (emptyMsg) {
        const what = text ? `“${q.value.trim()}”` : 'these filters';
        emptyMsg.textContent = `No items match ${what}${useLevel ? ` at level ${level}` : ''}. Clear the search${useLevel ? ' or turn off Only my level' : ' or pick fewer verdicts'}.`;
      }
      save('bags-filter', { acts, cat: cat.value, mine: mine.checked });
    }

    chips.forEach((c) =>
      c.addEventListener('click', () => {
        c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'));
        apply();
      }),
    );
    q.addEventListener('input', apply);
    cat.addEventListener('change', apply);
    mine.addEventListener('change', apply);
    clearQ?.addEventListener('click', () => {
      q.value = '';
      apply();
      q.focus();
    });
    document.querySelector('[data-clear-filters]')?.addEventListener('click', () => {
      q.value = '';
      cat.value = '';
      chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
      apply();
    });
    document.addEventListener(LEVEL_EVENT, apply);
    apply();
  }
</script>
