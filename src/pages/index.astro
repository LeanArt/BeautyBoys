---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Badge from '../components/Badge.astro';
import { site } from '../lib/site';
import { guides } from '../lib/guides';
import { routeFor } from '../lib/data';
import { levelLabel } from '../lib/wow';
import { CONFIDENCE } from '../lib/confidence';
import type { Confidence } from '../lib/data';
import type { IconName } from '../lib/icons';

const route = routeFor('gnome-warlock');
const stops = (route?.brackets ?? []).map((b) => ({ id: b.id, label: b.short ?? b.title, level: b.level }));
const steps = (route?.brackets ?? []).flatMap((b) => b.steps.map((s) => ({ id: s.id, title: s.title })));
const ready = guides.filter((g) => g.status === 'ready');

const features: { icon: IconName; href: string; title: string; line: string }[] = [
  { icon: 'signpost', href: '/guides/gnome-warlock/route/', title: 'Step-by-step route', line: 'Hub by hub with the key quests, trainers, demons and dungeons. Progress saves in your browser.' },
  { icon: 'pouch', href: '/bags/', title: 'Bag advisor', line: 'What to keep, sell, bank or buy at your level, and which vendor has it.' },
  { icon: 'anvil', href: '/guides/gnome-warlock/professions/', title: 'Professions & alts', line: 'The right professions for your main, and which extra characters can feed them.' },
  { icon: 'rune', href: '/systems/', title: "Forever's new systems", line: "Camping, Legacy points, the Cozy Sleeping Bag, Merchant's Favor, explained without jargon." },
  { icon: 'book', href: '/library-books/', title: 'Library books checklist', line: 'All the books with map coordinates, and what the turn-ins give you.' },
  { icon: 'info', href: '/glossary/', title: 'Glossary', line: 'DoT, aggro, rested XP, BoP: every word gamers throw around, in plain English.' },
];
const TRUST: Record<Confidence, string> = {
  official: 'Blizzard said it, or it is in the game data.',
  'beta-tested': 'Several beta players or guides saw the same thing.',
  community: 'One guide or player says so. Likely right, not double-checked.',
  theory: 'Nobody could test it: the beta stopped at level 30. Levels 30–60 will be updated as soon as people get there.',
};
---

<Base title={site.name} wide>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text">
      <h1 id="hero-title">Your first character in WoW: Forever, one step at a time.</h1>
      <p class="lede">
        A free leveling companion for people who've never played World of Warcraft. Pick a character, follow the route,
        tick off steps as you go, and always know what to keep, sell and buy.
      </p>
      <div class="cta" data-cta>
        <a class="btn primary" href="/start/" data-cta-start>New to WoW? Start here</a>
        <a class="btn" href="/guides/gnome-warlock/route/" data-cta-route>Open the Gnome Warlock route</a>
      </div>
      <p class="launch num" id="countdown" data-launch={site.launch}>
        Forever launches <time datetime={site.launch}>Wed 4 Nov 2026, 3:00 pm PST</time>.
      </p>
    </div>
    <div class="hero-side">
      {
        ready.map((g) => (
          <a class="card guide-card" href={`/guides/${g.id}/`} data-guide={g.id}>
            <p class="guide-meta">{g.faction}, available now</p>
            <h2 class="guide-name">
              {g.race} {g.className}
            </h2>
            <p class="guide-blurb">{g.blurb}</p>
            <p class="guide-start">
              <span class="fel-stone" aria-hidden="true" />
              Start at Coldridge Valley
            </p>
          </a>
        ))
      }
      <div class="card planned">
        <p class="guide-meta">More races and classes</p>
        <h2 class="guide-name">Coming after launch</h2>
        <p>The site is built so each new race and class is just new data. Tell us which one you want next.</p>
      </div>
    </div>
  </section>

  {
    stops.length > 0 && (
      <section aria-labelledby="road-title">
        <h2 id="road-title">The road from level 1 to 60</h2>
        <ol class="road">
          {stops.map((s) => (
            <li data-lmin={s.level[0]} data-lmax={s.level[1]}>
              <a href={`/guides/gnome-warlock/route/#${s.id}`}>
                <span class="stone" aria-hidden="true" />
                <span class="road-text">
                  <span class="tag num">{levelLabel(s.level)}</span>
                  <span class="road-name">{s.label}</span>
                  <span class="road-here">You are here</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section aria-labelledby="inside-title">
    <h2 id="inside-title">What's inside</h2>
    <ul class="features">
      {
        features.map((f) => (
          <li>
            <Icon name={f.icon} size={24} />
            <div>
              <a href={f.href}>{f.title}</a>
              <p>{f.line}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="trust-title">
    <h2 id="trust-title">How much to trust what you read</h2>
    <p class="prose">
      The game isn't out yet. Everything here comes from the beta (17 Sep – 22 Oct 2026), Blizzard's own notes, and the
      guides and players who tested it. Every step carries a trust seal:
    </p>
    <ul class="rows trust-rows">
      {
        (Object.keys(TRUST) as Confidence[]).map((c) => (
          <li>
            <Badge c={c} />
            <p>
              <strong>{CONFIDENCE[c].word}:</strong> {TRUST[c]}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <script type="application/json" id="route-steps" set:html={JSON.stringify(steps)} />
</Base>

<script>
  import { load } from '../scripts/storage';

  // Launch line: "Forever launches Wed 4 Nov 2026, 3:00 pm PST. In 6 days, 7 hours." (once a minute)
  const el = document.getElementById('countdown');
  if (el) {
    const launch = new Date(el.dataset.launch ?? '').getTime();
    const base = el.innerHTML;
    const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
    const tick = () => {
      if (Number.isNaN(launch)) return;
      const ms = launch - Date.now();
      if (ms <= 0) {
        el.textContent = 'WoW: Forever is live. Go get that Imp!';
        return;
      }
      const d = Math.floor(ms / 86400000);
      const h = Math.floor((ms % 86400000) / 3600000);
      const m = Math.floor((ms % 3600000) / 60000);
      const rest = d > 0 ? `${plural(d, 'day')}, ${plural(h, 'hour')}` : h > 0 ? `${plural(h, 'hour')}, ${plural(m, 'minute')}` : plural(m, 'minute');
      el.innerHTML = `${base} In ${rest}.`;
    };
    tick();
    setInterval(tick, 60000);
  }

  // Continue: once the route has ticks, the primary button resumes at the first unticked step.
  const ticked = load<string[]>('progress:route:gnome-warlock', []);
  const data = document.getElementById('route-steps');
  const start = document.querySelector<HTMLAnchorElement>('[data-cta-start]');
  const route = document.querySelector<HTMLAnchorElement>('[data-cta-route]');
  if (Array.isArray(ticked) && ticked.length > 0 && data && start && route) {
    const steps = JSON.parse(data.textContent ?? '[]') as { id: string; title: string }[];
    const next = steps.find((s) => !ticked.includes(s.id));
    if (next) {
      route.textContent = `Continue: ${next.title}`;
      route.href = `/guides/gnome-warlock/route/#${next.id}`;
      route.classList.add('primary');
      start.classList.remove('primary');
      route.after(start);
    }
  }
</script>

<style>
  .hero {
    display: grid;
    gap: var(--sp-8);
    grid-template-columns: minmax(0, 1fr);
    padding: var(--sp-2) 0 0;
  }
  .hero h1 {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.05;
    max-width: 18ch;
    margin: 0 0 var(--sp-4);
  }
  .hero .lede {
    margin-bottom: var(--sp-6);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta .btn {
    min-height: 48px;
    font-size: var(--fs-md);
    padding-inline: 18px;
  }
  @media (max-width: 599px) {
    .cta .btn {
      width: 100%;
    }
  }
  .launch {
    margin: var(--sp-4) 0 0;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .hero-side {
    display: grid;
    gap: var(--sp-4);
    align-content: start;
  }
  .guide-meta {
    margin: 0 0 4px;
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }
  .guide-name {
    margin: 0 0 8px;
    font: 700 var(--fs-xl) / 1.25 var(--font-body);
  }
  .guide-card .guide-name {
    color: var(--ink);
  }
  .guide-blurb {
    color: var(--ink-2);
  }
  .guide-start {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-weight: 700;
    color: var(--link);
  }
  .guide-card:hover .guide-start {
    text-decoration: underline;
  }
  .fel-stone {
    width: 12px;
    height: 12px;
    transform: rotate(45deg);
    background: var(--fel);
    box-shadow: 0 0 10px 2px var(--fel-glow);
  }
  .planned p:last-child {
    margin: 0;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 380px;
      column-gap: var(--sp-12);
      align-items: start;
    }
  }
  .trust-rows li {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
  }
  .trust-rows :global(.seal) {
    justify-self: start;
  }
  .trust-rows p {
    margin: 0;
  }
  @media (max-width: 499px) {
    .trust-rows li {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
  }
</style>
