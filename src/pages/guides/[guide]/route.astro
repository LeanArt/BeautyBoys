---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import GuideNav from '../../../components/GuideNav.astro';
import GuidePager from '../../../components/GuidePager.astro';
import StepCard from '../../../components/StepCard.astro';
import Leg from '../../../components/Leg.astro';
import ChecklistBar from '../../../components/ChecklistBar.astro';
import RefItem from '../../../components/RefItem.astro';
import Callout from '../../../components/Callout.astro';
import Badge from '../../../components/Badge.astro';
import Icon from '../../../components/Icon.astro';
import { guides, type Guide } from '../../../lib/guides';
import { routeFor, classFor } from '../../../lib/data';
import { levelLabel, formatDate } from '../../../lib/wow';
import { site } from '../../../lib/site';

export function getStaticPaths() {
  return guides.filter((g) => g.status === 'ready').map((guide) => ({ params: { guide: guide.id }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const route = routeFor(guide.id);
const cls = classFor(guide.id);
const base = `/guides/${guide.id}/`;

const overlaps = (a: [number, number], b: [number, number]) => a[0] <= b[1] && b[0] <= a[1];
const inRange = (lv: number, r: [number, number]) => lv >= r[0] && lv <= r[1];
const range = (r: [number, number]) => (r[0] === r[1] ? `${r[0]}` : `${r[0]}–${r[1]}`);

// Talent points and trainer spells that fall inside each bracket.
const extras = Object.fromEntries(
  (route?.brackets ?? []).map((b) => [
    b.id,
    {
      talents: cls?.spec.talents.filter((t) => overlaps(t.level, b.level)) ?? [],
      spells: cls?.spells.filter((s) => inRange(s.level, b.level)) ?? [],
    },
  ]),
);
const sections = (route?.brackets ?? []).map((b) => ({ id: b.id, label: b.short ?? b.title, level: b.level, total: b.steps.length }));
// The beta was capped, so everything above the cap is untested.
const testedTo = site.betaLevelCap;
// Untested brackets carry one Untested callout, so the data's "(untested)" title suffix and
// "Untested –" / "Untested." summary lead are dropped here (say it once per bracket).
const stripTitle = (t: string) => t.replace(/\s*\(untested\)\s*$/i, '');
const stripSummary = (t: string) => {
  const rest = t.replace(/^untested\s*(?:[–—-]\s*|\.\s*)/i, '');
  return rest.charAt(0).toUpperCase() + rest.slice(1);
};
---

<Base
  title={`Route: ${guide.race} ${guide.className}`}
  description={`Hub-by-hub leveling route for the ${guide.race} ${guide.className} in WoW: Forever.`}
  rail="md"
  dock
  guide={guide.id}
>
  <Fragment slot="head">
    <PageHead
      title="Leveling route"
      trail={[{ href: base, label: `${guide.race} ${guide.className} guide` }]}
      facts={route
        ? [
            { label: 'Updated', value: formatDate(route.updated) },
            { label: 'Played in beta', value: `Levels 1–${testedTo}` },
          ]
        : []}
      levelPrompt
    >
      Hub by hub, with the quests that matter. Tick each step when you've done it. Your progress stays in this browser.
    </PageHead>
    <GuideNav guide={guide} />
  </Fragment>

  {route && <ChecklistBar slot="rail" sections={sections} />}

  {
    !route ? (
      <Callout variant="warn">
        <p>The route is being written. Check back soon.</p>
      </Callout>
    ) : (
      <Fragment>
        <Callout variant="info" label="How to read this">
          <p>
            Do the steps roughly in order, but don't stress: skipping a step is fine. Levels 1–{testedTo} come from the beta.
            Steps marked <Badge c="theory" /> haven't been played by anyone yet. Copy a <code>/way</code> and paste it into
            game chat to get a TomTom arrow.
          </p>
        </Callout>

        {route.brackets.map((b) => {
          const { talents, spells } = extras[b.id];
          const untested = b.level[0] >= site.betaLevelCap;
          return (
            <Leg
              id={b.id}
              level={b.level}
              title={untested ? stripTitle(b.title) : b.title}
              zones={b.zones}
              total={b.steps.length}
              summary={untested ? stripSummary(b.summary) : b.summary}
              untested={untested}
            >
              {(talents.length > 0 || spells.length > 0) && (
                <details class="bracket-extras" slot="extras">
                  <summary>
                    New talents and spells at levels {range(b.level)}
                    <Icon name="chevron-down" size={16} class="chev" />
                  </summary>
                  <div class="extras-body">
                    {talents.length > 0 && (
                      <Fragment>
                        <p class="extras-label">Talent points</p>
                        <ul class="inline-refs">
                          {talents.map((t) => (
                            <li>
                              <span class="tag num">{levelLabel(t.level)}</span>
                              <RefItem r={{ name: t.talent, wh: t.wh }} variant="inline" />
                              <span class="num">{t.ranks}</span>
                            </li>
                          ))}
                        </ul>
                      </Fragment>
                    )}
                    {spells.length > 0 && (
                      <Fragment>
                        <p class="extras-label">At the trainer</p>
                        <ul class="inline-refs">
                          {spells.map((s) => (
                            <li>
                              <span class="tag num">Lv {s.level}</span>
                              <span>
                                {s.spells.map((sp, i) => (
                                  <Fragment>{i > 0 && ', '}<RefItem r={sp} variant="inline" /></Fragment>
                                ))}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </Fragment>
                    )}
                    <p>
                      <a href={`${base}talents/`}>Full talent plan and spell list</a>
                    </p>
                  </div>
                </details>
              )}
              {b.steps.map((s) => (
                <StepCard step={s} />
              ))}
            </Leg>
          );
        })}
      </Fragment>
    )
  }
  <GuidePager guide={guide} />
</Base>

<script>
  import { initProgress } from '../../../scripts/progress';
  const guide = location.pathname.split('/').filter(Boolean)[1] ?? 'unknown';
  initProgress(`route:${guide}`);
</script>
