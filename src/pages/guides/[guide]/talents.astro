---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import GuideNav from '../../../components/GuideNav.astro';
import GuidePager from '../../../components/GuidePager.astro';
import OnThisPage from '../../../components/OnThisPage.astro';
import Badge from '../../../components/Badge.astro';
import Trust from '../../../components/Trust.astro';
import Sources from '../../../components/Sources.astro';
import RefItem from '../../../components/RefItem.astro';
import Callout from '../../../components/Callout.astro';
import Icon from '../../../components/Icon.astro';
import { guides, type Guide } from '../../../lib/guides';
import { classFor } from '../../../lib/data';
import { wowheadUrl, levelLabel, formatDate } from '../../../lib/wow';

export function getStaticPaths() {
  return guides.filter((g) => g.status === 'ready').map((guide) => ({ params: { guide: guide.id }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const cls = classFor(guide.id);
if (!cls) throw new Error(`Missing class data for ${guide.id}`);
const { spec } = cls;
const base = `/guides/${guide.id}/`;
const toc = [
  { id: 'talents', label: 'Talent plan' },
  { id: 'rotation', label: 'What to press' },
  { id: 'demons', label: 'Demons' },
  { id: 'spells', label: 'Spells by level' },
  { id: 'shards', label: 'Soul Shards' },
  { id: 'dual', label: 'Dual spec' },
];
---

<Base title={`Talents, spells & demons: ${guide.race} ${guide.className}`} rail="lg" guide={guide.id}>
  <Fragment slot="head">
    <PageHead
      title="Talents, spells & demons"
      trail={[{ href: base, label: `${guide.race} ${guide.className} guide` }]}
      facts={[{ label: 'Updated', value: formatDate(cls.updated) }]}
      levelPrompt
    >
      What to put your talent points into, which demon to use, and what to press.
    </PageHead>
    <GuideNav guide={guide} />
  </Fragment>

  <OnThisPage slot="rail" items={toc} />

  <section id="talents">
    <h2>Talent plan: {spec.name}</h2>
    <p class="prose">{spec.summary}</p>
    <Callout variant="warn">
      <p>{spec.note}</p>
    </Callout>
    <div class="trust-line">
      <span>How sure we are:</span>
      <Trust c={spec.confidence} urls={spec.sources} report="talent plan" />
      <a href="https://www.wowhead.com/forever/talent-calc" target="_blank" rel="noopener" class="ext"
        >Wowhead's Forever talent calculator<Icon name="external" size={16} /></a
      >
    </div>
    <div class="table-wrap">
      <table class="data stack" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Level</th>
            <th role="columnheader" scope="col">Talent</th>
            <th role="columnheader" scope="col" class="c-num">Points</th>
            <th role="columnheader" scope="col">Why</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            spec.talents.map((t) => (
              <tr role="row" data-lmin={t.level[0]} data-lmax={t.level[1]}>
                <td role="cell" class="c-lv">
                  <span class="tag num">{levelLabel(t.level)}</span>
                  <span class="tag now">Now</span>
                </td>
                <td role="cell" class="c-main">
                  {t.wh ? (
                    <a href={wowheadUrl(t.wh)} target="_blank" rel="noopener">
                      {t.talent}
                    </a>
                  ) : (
                    t.talent
                  )}
                  <span class="sub">{t.tree}</span>
                </td>
                <td role="cell" class="c-num num">
                  {t.ranks}
                </td>
                <td role="cell" class="c-why">
                  {t.why}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h3>Other ways to play</h3>
    <div class="grid">
      {
        spec.alternatives.map((a) => (
          <section class="card">
            <h4>{a.name}</h4>
            <p>{a.summary}</p>
            <Trust c={a.confidence} urls={a.sources} report={`talent alternative "${a.name}"`} />
          </section>
        ))
      }
    </div>
  </section>

  <section id="rotation">
    <h2>What to press</h2>
    <div class="grid">
      {
        cls.rotations.map((r) => (
          <section class="card" data-lmin={r.level[0]} data-lmax={r.level[1]}>
            <div class="card-tags">
              <span class="tag num">{levelLabel(r.level)}</span>
              <span class="tag now">Now</span>
            </div>
            <h3 class="h4">{r.title}</h3>
            <ol class="steps-list">
              {r.steps.map((s) => (
                <li>{s}</li>
              ))}
            </ol>
            <Trust c={r.confidence} urls={r.sources} report={`rotation "${r.title}"`} />
          </section>
        ))
      }
    </div>
  </section>

  <section id="demons">
    <h2>Demons</h2>
    <div class="grid">
      {
        cls.demons.map((d) => (
          <section class="card" data-lmin={d.level} data-lmax={d.level + 9}>
            <div class="card-tags">
              <span class="tag num">Lv {d.level}</span>
              <span class="tag now">Now</span>
            </div>
            <h3 class="h4">
              {d.wh ? (
                <a href={wowheadUrl(d.wh)} target="_blank" rel="noopener">
                  {d.name}
                </a>
              ) : (
                d.name
              )}
            </h3>
            <p>
              <strong>How:</strong> {d.how}
            </p>
            <p>
              <strong>Use:</strong> {d.use}
            </p>
            <Trust c={d.confidence} urls={d.sources} report={`demon "${d.name}"`} />
          </section>
        ))
      }
    </div>
  </section>

  <section id="spells">
    <h2>New spells by level</h2>
    <p class="prose muted">{cls.spellsNote}</p>
    <div class="table-wrap">
      <table class="data stack" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Level</th>
            <th role="columnheader" scope="col">You can learn</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            cls.spells.map((row) => (
              <tr role="row" data-lmin={row.level} data-lmax={row.level + 1}>
                <td role="cell" class="c-lv">
                  <span class="tag num">Lv {row.level}</span>
                  <span class="tag now">Now</span>
                </td>
                <td role="cell" class="c-main spells">
                  {row.spells.map((s, i) => (
                    <Fragment>{i > 0 && ', '}<RefItem r={s} variant="inline" />{s.note && <span class="spell-note"> ({s.note})</span>}</Fragment>
                  ))}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="trust-line">
      <span>Levels from the Forever ability list:</span>
      <Badge c="official" />
    </div>
    <Sources urls={['https://warcraft.wiki.gg/wiki/Warlock_abilities_(Forever)', 'https://www.warcrafttavern.com/forever/guides/warlock-leveling/']} />
  </section>

  <section id="shards">
    <h2>Soul Shards</h2>
    <ul class="prose">
      {cls.shards.map((s) => <li>{s}</li>)}
    </ul>
    <Sources
      urls={[
        'https://us.forums.blizzard.com/en/wow/t/2389364',
        'https://us.forums.blizzard.com/en/wow/t/2368623',
        'https://www.warcrafttavern.com/forever/guides/warlock/',
      ]}
    />
  </section>

  <section id="dual">
    <h2>Dual spec at level {cls.dualSpec.level}</h2>
    <div class="card">
      <p>{cls.dualSpec.body}</p>
      <p><strong>Cost:</strong> {cls.dualSpec.cost}</p>
      <Trust c={cls.dualSpec.confidence} urls={cls.dualSpec.sources} report="dual spec" />
    </div>
  </section>

  <GuidePager guide={guide} />
</Base>

<style>
  .ext {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--hit);
  }
  td.c-main.spells {
    font-weight: 400;
  }
  .spell-note {
    color: var(--ink-3);
    font-size: var(--fs-sm);
    font-weight: 400;
  }
  .card .steps-list {
    margin-bottom: var(--sp-3);
  }
</style>
