---
// Fastest route: a step-by-step 1–60 route (RestedXP style), separate from the hub-level Route page.
// Data: src/data/fast-route-<guide>.json (schema FastRoute). Progress scope: `fast-route:<guide>`.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import GuideNav from '../../../components/GuideNav.astro';
import GuidePager from '../../../components/GuidePager.astro';
import FastStepRow from '../../../components/FastStepRow.astro';
import Leg from '../../../components/Leg.astro';
import ChecklistBar from '../../../components/ChecklistBar.astro';
import Callout from '../../../components/Callout.astro';
import Trust from '../../../components/Trust.astro';
import Icon from '../../../components/Icon.astro';
import { guides, type Guide } from '../../../lib/guides';
import { fastRouteFor } from '../../../lib/data';
import { formatDate, wowheadUrl } from '../../../lib/wow';
import { md } from '../../../lib/md';

export function getStaticPaths() {
  return guides.filter((g) => g.status === 'ready').map((guide) => ({ params: { guide: guide.id }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const route = fastRouteFor(guide.id);
const base = `/guides/${guide.id}/`;
const legs = route?.legs ?? [];

// Whole-level range of a leg (decimals in the data mean "partway into a level").
const whole = (l: [number, number]): [number, number] => [Math.floor(l[0]), Math.max(Math.floor(l[0]), Math.floor(l[1]))];
const range = (l: [number, number]) => (l[0] === l[1] ? `${l[0]}` : `${l[0]}–${l[1]}`);

// A step stays "current" for your level until the next step's level.
const all = legs.flatMap((l) => l.steps);
const lmaxOf = new Map(all.map((s, i) => [s.id, Math.floor(all[i + 1]?.lvl ?? s.lvl)]));
const sections = legs.map((l) => ({ id: l.id, label: l.short, level: whole(l.level), total: l.steps.length }));
const dungeonsOf = (l: (typeof legs)[number]) => l.steps.filter((s) => s.do === 'dungeon');
const counts = {
  steps: all.length,
  quests: new Set(all.flatMap((s) => (s.quests ?? []).filter((q) => q.op === 'turnin').map((q) => q.name))).size,
  dungeons: all.filter((s) => s.do === 'dungeon').length,
};
const theoryFrom = legs.find((l) => l.steps.filter((s) => s.confidence === 'theory').length > l.steps.length / 2)?.level[0];
---

<Base
  title={`Fastest route: ${guide.race} ${guide.className}`}
  description={`Step-by-step fastest 1–60 leveling route for the ${guide.race} ${guide.className} in WoW: Forever: quests, mobs, dungeons and travel in order.`}
  rail="md"
  dock
  guide={guide.id}
>
  <Fragment slot="head">
    <PageHead
      title="Fastest leveling route"
      trail={[{ href: base, label: `${guide.race} ${guide.className} guide` }]}
      facts={route
        ? [
            { label: 'Updated', value: formatDate(route.updated) },
            { label: 'Steps', value: `${counts.steps}` },
            ...(route.estTime ? [{ label: 'Time to 60', value: route.estTime }] : []),
          ]
        : []}
      levelPrompt
    >
      Every stop from 1 to 60, in the order that wastes the least time: which quests to pick up, what to kill, when to
      run a dungeon and when to move on. Tick each step as you go. Your progress stays in this browser.
    </PageHead>
    <GuideNav guide={guide} />
  </Fragment>

  {route && <ChecklistBar slot="rail" sections={sections} />}

  {
    !route ? (
      <Callout variant="warn">
        <p>The fastest route is being researched. Check back soon, or use the <a href={`${base}route/`}>hub-by-hub route</a>.</p>
      </Callout>
    ) : (
      <Fragment>
        <Callout variant="info" label="How this route works">
          <div set:html={`<p>${md(route.summary)}</p>`} />
          <ul class="fast-assumptions">
            {route.assumptions.map((a) => (
              <li set:html={md(a)} />
            ))}
          </ul>
          <p>
            Want the bigger picture instead? The <a href={`${base}route/`}>hub-by-hub route</a> explains each area in plain
            words. This page is the turn-by-turn version.
          </p>
        </Callout>

        <section class="fast-glance" aria-labelledby="glance">
          <h2 id="glance">The route at a glance</h2>
          <p>
            {counts.steps} steps, about {counts.quests} quest turn-ins and {counts.dungeons} dungeon runs.
            {theoryFrom !== undefined && (
              <Fragment>
                {' '}From level {Math.floor(theoryFrom)} most steps are <strong>Theory</strong>: the beta stopped at 30 and
                launch players have only just got there, so these follow the fastest Classic route, adjusted for what
                Forever changed.
              </Fragment>
            )}
          </p>
          <div class="table-wrap">
            <table class="data stack" role="table">
              <thead role="rowgroup">
                <tr role="row">
                  <th role="columnheader" scope="col" class="c-lv">Level</th>
                  <th role="columnheader" scope="col">Where</th>
                  <th role="columnheader" scope="col">Dungeons</th>
                  <th role="columnheader" scope="col" class="c-num">Time</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {legs.map((l) => {
                  const w = whole(l.level);
                  return (
                    <tr role="row" data-lmin={w[0]} data-lmax={w[1]}>
                      <td role="cell" class="c-lv">
                        <span class="tag num">Lv {range(w)}</span>
                        <span class="tag now">Now</span>
                      </td>
                      <td role="cell" class="c-main">
                        <a href={`#${l.id}`}>{l.short}</a>
                        <span class="sub">{l.zones.join(', ')}</span>
                      </td>
                      <td role="cell" data-label="Dungeons:">
                        {dungeonsOf(l).length ? dungeonsOf(l).map((d) => d.at ?? d.text.replace(/\*\*/g, '')).join(', ') : 'None'}
                      </td>
                      <td role="cell" class="c-num">{l.estTime ?? '–'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        {route.decisions && route.decisions.length > 0 && (
          <section class="fast-forks" aria-labelledby="forks">
            <h2 id="forks">Where this route chooses</h2>
            <p>
              At these points there is more than one good road. This is what we picked and why, so you can make a different
              call if your situation is different (a group of friends, a crowded zone).
            </p>
            <ol class="fork-list">
              {route.decisions.map((d) => (
                <li class="fork" data-lmin={Math.floor(d.level[0])} data-lmax={Math.floor(d.level[1])}>
                  <p class="fork-q">
                    <span class="tag num">Lv {range(whole(d.level))}</span> {d.fork}
                  </p>
                  <p class="fork-a">
                    <strong>{d.choice}</strong>
                  </p>
                  <p class="fork-why" set:html={md(d.why)} />
                  <Trust c={d.confidence} urls={d.sources} report={`fast route decision "${d.fork}"`} />
                </li>
              ))}
            </ol>
          </section>
        )}

        {legs.map((l) => {
          const theory = l.steps.filter((s) => s.confidence === 'theory').length;
          return (
            <Leg id={l.id} level={whole(l.level)} title={l.title} zones={l.zones} total={l.steps.length} summary={l.summary}>
              <Fragment slot="extras">
                <p class="leg-route-facts">
                  <span>Starts: {l.start}</span>
                  <span>Ends: {l.end}</span>
                  {l.estTime && <span>Time: {l.estTime}</span>}
                </p>
                {theory > l.steps.length / 2 && (
                  <Callout variant="untested" compact>
                    <p>
                      {theory} of {l.steps.length} steps here are Theory: nobody has confirmed them in Forever yet.
                    </p>
                  </Callout>
                )}
                <details class="bracket-extras">
                  <summary>
                    Why this order{l.skipped?.length ? `, and ${l.skipped.length} quests we skip` : ''}
                    <Icon name="chevron-down" size={16} class="chev" />
                  </summary>
                  <div class="extras-body">
                    <p set:html={md(l.why)} />
                    {l.skipped && l.skipped.length > 0 && (
                      <Fragment>
                        <p class="extras-label">Skipped on purpose</p>
                        <ul class="inline-refs">
                          {l.skipped.map((s) => (
                            <li>
                              <span class="ref-inline">
                                {s.wh ? (
                                  <a href={wowheadUrl(s.wh)} target="_blank" rel="noopener">
                                    {s.name}
                                  </a>
                                ) : (
                                  s.name
                                )}
                              </span>
                              <span class="skip-why">{s.why}</span>
                            </li>
                          ))}
                        </ul>
                      </Fragment>
                    )}
                    {l.openQuestions && l.openQuestions.length > 0 && (
                      <Fragment>
                        <p class="extras-label">Still unknown</p>
                        <ul class="open-qs">
                          {l.openQuestions.map((q) => (
                            <li>{q}</li>
                          ))}
                        </ul>
                      </Fragment>
                    )}
                  </div>
                </details>
              </Fragment>
              {l.steps.map((s) => (
                <FastStepRow step={s} lmax={lmaxOf.get(s.id) ?? Math.floor(s.lvl)} />
              ))}
            </Leg>
          );
        })}
      </Fragment>
    )
  }
  <GuidePager guide={guide} />
</Base>

<script>
  import { initProgress } from '../../../scripts/progress';
  import { load, save } from '../../../scripts/storage';
  const guide = location.pathname.split('/').filter(Boolean)[1] ?? 'unknown';
  const scope = `fast-route:${guide}`;
  // Hundreds of steps: start in Compact view (instruction, level, /way) unless the reader chose otherwise.
  if (load<string | null>(`view:${scope}`, null) === null) save(`view:${scope}`, 'compact');
  initProgress(scope);
</script>

<style>
  .fast-assumptions { margin: 8px 0; padding-left: 1.2em; }
  .fast-assumptions li { margin: 4px 0; }
  .fast-glance, .fast-forks { margin: var(--sp-8) 0; }
  .fork-list { list-style: none; margin: var(--sp-4) 0 0; padding: 0; }
  .fork { padding: var(--sp-4) 0; border-top: 1px solid var(--rule); }
  .fork:first-child { border-top: 0; }
  .fork p { margin: 0 0 6px; max-width: 64ch; }
  .fork-q { font-weight: 600; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }
  .fork-why { font-size: var(--fs-sm); }
  .fork[data-now='current'] .fork-q .tag { border-color: var(--fel-line); }
  .leg-route-facts { display: flex; flex-direction: column; gap: 2px; margin: 8px 0; font-size: var(--fs-sm); color: var(--ink-2); max-width: 64ch; }
  .skip-why { color: var(--ink-3); }
  .open-qs { margin: 4px 0; padding-left: 1.2em; }
  .open-qs li { margin: 2px 0; }
</style>
