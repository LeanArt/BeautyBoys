---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import GuideNav from '../../../components/GuideNav.astro';
import Badge from '../../../components/Badge.astro';
import Sources from '../../../components/Sources.astro';
import RefItem from '../../../components/RefItem.astro';
import { guides, type Guide } from '../../../lib/guides';
import { professionsFor } from '../../../lib/data';
import { md } from '../../../lib/md';

export function getStaticPaths() {
  return guides.filter((g) => g.status === 'ready').map((guide) => ({ params: { guide: guide.id }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const data = professionsFor(guide.id);
const primary = data?.plans.filter((p) => p.type === 'primary') ?? [];
const secondary = data?.plans.filter((p) => p.type === 'secondary') ?? [];
---

<Base title={`Professions & alts – ${guide.race} ${guide.className}`}>
  <PageHead eyebrow={`${guide.race} ${guide.className}`} title="Professions & support alts">
    Which professions to take, the moments they pay off while leveling, and which extra characters can keep them fed.
  </PageHead>
  <GuideNav guide={guide} />

  {
    !data ? (
      <div class="callout warn">
        <p>The professions plan is being written. Check back soon.</p>
      </div>
    ) : (
      <Fragment>
        <div class="callout fel">
          <p set:html={md(data.summary)} />
        </div>

        <ul class="toc">
          {[...primary, ...secondary].map((p) => (
            <li>
              <a class="pill" href={`#${p.id}`}>
                {p.name}
              </a>
            </li>
          ))}
          <li>
            <a class="pill" href="#alts">
              Support alts
            </a>
          </li>
          <li>
            <a class="pill" href="#sharing">
              Moving items between characters
            </a>
          </li>
        </ul>

        {[
          { title: 'Main professions (pick two)', plans: primary },
          { title: 'Secondary professions (take them all)', plans: secondary },
        ].map((group) =>
          group.plans.length === 0 ? null : (
            <section>
              <h2>{group.title}</h2>
              {group.plans.map((p) => (
                <article class="prof card" id={p.id}>
                  <h3>{p.name}</h3>
                  <p class="role">{p.role}</p>

                  {p.trainers.length > 0 && (
                    <div class="trainers">
                      <h4>Trainers on your route</h4>
                      <ul>
                        {p.trainers.map((t) => (
                          <li>
                            <RefItem r={t} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {p.milestones.length > 0 && (
                    <div class="table-wrap">
                      <table>
                        <thead>
                          <tr>
                            <th>Skill</th>
                            <th>Milestone</th>
                          </tr>
                        </thead>
                        <tbody>
                          {p.milestones.map((m) => (
                            <tr data-lmin={m.level ?? 0} data-lmax={m.level ?? 0}>
                              <td class="skill">
                                <span class="pill level">{m.skill}</span>
                                {m.level && <div class="muted small">~ Lv {m.level}</div>}
                              </td>
                              <td>
                                <strong>{m.title}</strong>
                                <p set:html={md(m.body)} />
                                {m.crafts && m.crafts.length > 0 && (
                                  <ul class="crafts">
                                    {m.crafts.map((c) => (
                                      <li>
                                        <RefItem r={c} />
                                      </li>
                                    ))}
                                  </ul>
                                )}
                                <div class="foot">
                                  <Badge c={m.confidence} />
                                  <Sources urls={m.sources} />
                                </div>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}

                  {p.needsFromOthers && p.needsFromOthers.length > 0 && (
                    <div class="needs">
                      <h4>Needs from other professions</h4>
                      <ul>
                        {p.needsFromOthers.map((n) => (
                          <li>
                            <RefItem r={n.item} /> <span class="muted">– from {n.from}, for {n.usedFor}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </article>
              ))}
            </section>
          ),
        )}

        <section id="alts">
          <h2>Support alts</h2>
          <p class="muted">
            Extra characters on your account whose professions feed your main. You don't need any of them – but if you
            enjoy playing a second character, these make your main's life easier.
          </p>
          <div class="grid">
            {data.alts.map((a) => (
              <article class="card alt">
                <h3>{a.title}</h3>
                <p class="pros">{a.professions.join(' + ')}</p>
                <p>
                  <strong>Who:</strong> {a.suggestion}
                </p>
                <p set:html={md(a.why)} />
                {a.feeds.length > 0 && (
                  <Fragment>
                    <h4>Feeds your main</h4>
                    <ul>
                      {a.feeds.map((f) => (
                        <li>
                          <RefItem r={f.item} /> <span class="muted">– {f.usedFor}</span>
                        </li>
                      ))}
                    </ul>
                  </Fragment>
                )}
                <Badge c={a.confidence} />
                <Sources urls={a.sources} />
              </article>
            ))}
          </div>
        </section>

        <section id="sharing">
          <h2>Moving items between your characters</h2>
          <div class="grid">
            {data.howToShare.map((h) => (
              <div class="card">
                <h3>{h.title}</h3>
                <p set:html={md(h.body)} />
                <Badge c={h.confidence} />
                <Sources urls={h.sources} />
              </div>
            ))}
          </div>
        </section>
      </Fragment>
    )
  }
</Base>

<style>
  .prof {
    margin-bottom: 1.2rem;
  }
  .prof h3,
  .alt h3,
  .grid .card h3 {
    margin-top: 0;
  }
  .role {
    color: var(--muted);
  }
  h4 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin: 0.9rem 0 0.3rem;
  }
  .trainers ul,
  .needs ul,
  .alt ul,
  .crafts {
    padding-left: 1.1rem;
    margin: 0 0 0.6rem;
  }
  .table-wrap {
    margin-top: 0.8rem;
    box-shadow: none;
  }
  td p {
    margin: 0.2rem 0 0.3rem;
  }
  .skill {
    width: 6rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.8rem;
  }
  .foot :global(details.sources) {
    margin-top: 0;
  }
  .pros {
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  tr[data-now='current'] td {
    background: var(--accent-soft);
  }
</style>
